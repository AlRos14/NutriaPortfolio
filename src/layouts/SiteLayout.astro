---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import Consent from '../components/site/Consent.astro';
import '../styles/site.css';
interface Props { title: string; description: string; lang?: string; }
const { title, description, lang = 'es' } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Nutria</title><meta name="description" content={description} /><link rel="icon" href="/nutria-logo.png" type="image/png" /></head><body><Header /><main id="main" tabindex="-1"><slot /></main><Footer /><Consent /></body></html>
