---
import Layout from '../layouts/SiteLayout.astro';
import { scenarios } from '../data/organization-explorer';
import '../styles/explorer.css';
---
<Layout noindex title="Tu organización con Nutria" description="Explora un esquema ilustrativo de empresa con personas, Sis y agentes. Diseña puestos, responsabilidades y coordinación en un prototipo interactivo.">
<section class="explorer-intro"><div><p class="eyebrow">Tu organización con Nutria</p><h1>Imagina la capacidad<br />que te falta.</h1><p class="lead">Cuéntanos dónde estás. Explora qué puestos podrían ayudarte y cómo se organizarían alrededor de tu empresa.</p></div><p class="prototype-label"><strong>Prototipo interactivo</strong>Escenarios predefinidos. Sin conexión a Sis ni agentes reales.</p></section>
<noscript><style is:inline>[data-explorer]{display:none!important}</style></noscript>
<section class="organization-explorer" data-explorer>
  <div class="explorer-heading"><div class="sis-mark" aria-hidden="true">S</div><div><h2>Diseña tu equipo con Sis</h2><p>Una vista previa de la experiencia que queremos construir.</p></div><a class="text-link" href="/sis/">Qué es Sis <span aria-hidden="true">↗</span></a></div>
  <ol class="explorer-progress" aria-label="Pasos del configurador"><li aria-current="step"><span>01</span>Tu empresa</li><li><span>02</span>Lo que necesitas</li><li><span>03</span>Una estructura posible</li></ol>
  <form id="organization-form"><fieldset id="explorer-inputs" disabled aria-label="Datos para explorar tu organización">
    <div data-step="1" class="explorer-step"><div class="step-intro"><p class="eyebrow">01 / El punto de partida</p><h3>Una empresa real.<br />Su propia manera de trabajar.</h3><p>El tamaño cambia la estructura que exploramos. No determina por sí solo cuántos agentes necesitas.</p></div><div class="explorer-fields"><label for="company-kind">Tipo de empresa</label><select id="company-kind" name="kind"><option value="Ecommerce y retail">Ecommerce y retail</option><option value="Servicios profesionales">Servicios profesionales</option><option value="Industria y distribución">Industria y distribución</option><option value="Otro tipo de empresa">Otro tipo de empresa</option></select><label for="company-size">Personas en la organización</label><select id="company-size" name="size"><option value="small">1–10 personas</option><option value="growing">11–50 personas</option><option value="established">51–250 personas</option><option value="large">Más de 250 personas</option></select><button class="button" type="button" data-next="2">Qué capacidad te falta <span aria-hidden="true">→</span></button></div></div>
    <div data-step="2" class="explorer-step" hidden><div class="step-intro"><p class="eyebrow">02 / Tu siguiente capacidad</p><h3>¿Dónde quieres<br />que avance la empresa?</h3><p>Elige un punto de partida. Después podrás explorar las funciones del equipo y el nivel de autonomía.</p></div><div class="explorer-fields"><fieldset class="scenario-options"><legend>Elige una necesidad</legend>{scenarios.map((scenario, i) => <label><input type="radio" name="scenario" value={scenario.id} checked={i === 0} /><span><strong>{scenario.label}</strong><span>{scenario.description}</span></span></label>)}</fieldset><label for="company-need">¿Qué os falta hoy? <span>(opcional)</span></label><textarea id="company-need" name="need" rows="3" maxlength="600" placeholder="Por ejemplo: queremos seguir mejor el mercado, pero nadie puede darle continuidad."></textarea><p class="small-note">Se incluye en tu resumen. Este prototipo no interpreta el texto ni lo envía a un servidor.</p><div class="step-actions"><button class="text-link" type="button" data-back="1">← Tu empresa</button><button class="button" type="submit">Ver una estructura posible <span aria-hidden="true">→</span></button></div></div></div>
  </fieldset></form>
  <div data-step="3" hidden>
    <div class="result-toolbar"><div><p class="eyebrow">03 / Una estructura posible</p><h3 tabindex="-1" id="result-title">Tu empresa, con más capacidad.</h3><p id="company-summary"></p></div><button class="text-link" type="button" data-back="1">Cambiar punto de partida <span aria-hidden="true">↗</span></button></div>
    <p class="result-status" role="status" id="explorer-status"></p>
    <div class="explorer-result"><div class="organization-canvas"><p class="canvas-label">Personas + agentes / esquema ilustrativo</p><div class="human-node"><span>DECISIÓN EMPRESARIAL</span><strong id="human-team">Dirección y equipo</strong><p>Estrategia, mandato y decisiones reservadas.</p></div><div class="diagram-connector" aria-hidden="true"></div><div class="sis-node"><span>SIS / COORDINACIÓN</span><strong>Un punto para conectar al equipo</strong><p>Personas, agentes y contexto de organización.</p></div><div class="diagram-connector" aria-hidden="true"></div><p class="area-label" id="area-label"></p><div id="agent-nodes" class="agent-nodes" role="group" aria-label="Explorar puestos del esquema"></div><p class="canvas-note">Selecciona un puesto para ver qué trabajo asume y qué decisiones conserva la empresa.</p></div>
    <aside class="role-inspector" aria-labelledby="role-title"><p class="eyebrow">El puesto, por dentro</p><h4 id="role-title"></h4><p id="role-mission"></p><h5>Trabajo que asume</h5><ul id="role-work"></ul><h5>Cómo se incorpora</h5><p id="role-rules"></p><h5>Fuentes y herramientas</h5><p id="role-sources"></p><h5>Decisiones reservadas</h5><p id="role-decisions"></p></aside></div>
    <div class="autonomy-explorer"><div><p class="eyebrow">Cómo quieres que trabaje</p><h4>Autonomía con un alcance definido.</h4><p>Explora tres formas de organizar el área. Aquí no se conceden permisos reales.</p></div><div><fieldset id="autonomy-options"><legend class="visually-hidden">Modo de trabajo del área</legend><label><input type="radio" name="autonomy" value="review" /><span>Con revisión previa</span></label><label><input type="radio" name="autonomy" value="scoped" checked /><span>Autonomía por alcance</span></label><label><input type="radio" name="autonomy" value="area" /><span>Responsable de área</span></label></fieldset><p id="autonomy-explanation" role="status"></p></div></div>
    <div class="result-next"><div><p class="eyebrow">Antes de ponerlo en marcha</p><h4>Puntos que conviene resolver.</h4><p id="size-guidance"></p><ul id="setup-checks"></ul><p id="need-summary"></p></div><div><h4>Del esquema a tu empresa.</h4><p>Este es un escenario editorial, no un diagnóstico ni una configuración contratada. Revisaremos el trabajo, las integraciones y la estructura que realmente necesitas.</p><a class="button" id="explorer-contact" href="mailto:info@ainutria.com">Preparar una consulta <span aria-hidden="true">↗</span></a><p class="small-note">Se abre tu correo con un resumen. Tú decides si enviarlo.</p><button class="text-link" type="button" id="explorer-reset">Empezar de nuevo</button></div></div>
  </div>
</section>
<noscript><section><h2>Explora los puestos de tu empresa</h2><p>El configurador necesita JavaScript. Puedes consultar los escenarios de trabajo y hablar con nosotros directamente.</p><div class="actions"><a class="button" href="/casos-de-uso/">Ver escenarios</a><a class="button secondary" href="/contacto/">Hablemos</a></div></section></noscript>
<template id="agent-node-template"><button type="button" class="agent-node" aria-pressed="false"><span></span><strong></strong><small>Ver responsabilidad <span aria-hidden="true">↗</span></small></button></template>
</Layout>
<script>
  import { scenarios } from '../data/organization-explorer';
  const root = document.querySelector<HTMLElement>('[data-explorer]');
  const form = document.querySelector<HTMLFormElement>('#organization-form');
  const text = (id: string, value: string) => { const node = document.getElementById(id); if (node) node.textContent = value; };
  function list(id: string, items: readonly string[]) { const node = document.getElementById(id); if (!node) return; node.replaceChildren(...items.map(value => { const li = document.createElement('li'); li.textContent = value; return li; })); }
  function step(index: number) {
    if (form) form.hidden = index === 3;
    root?.querySelectorAll<HTMLElement>('[data-step]').forEach(node => node.hidden = Number(node.dataset.step) !== index);
    root?.querySelectorAll('.explorer-progress li').forEach((node, i) => { if (i + 1 === index) node.setAttribute('aria-current', 'step'); else node.removeAttribute('aria-current'); });
    const heading = root?.querySelector<HTMLElement>(`[data-step="${index}"] h3`);
    if (heading) { heading.tabIndex = -1; heading.focus(); heading.scrollIntoView({ block: 'start' }); }
  }
  type Role = { name: string; mission: string; work: readonly string[]; rules: string; decisions: string; sources: string; };
  let currentScenario: typeof scenarios[number] = scenarios[0];
  const modes: Record<string, string> = {
    review: 'Prepara propuestas y reúne la información. Las acciones del puesto pasan por la revisión acordada antes de ejecutarse.',
    scoped: 'Avanza sin supervisión en cada paso dentro de los procedimientos, herramientas y decisiones autorizadas. Consulta las excepciones concretas.',
    area: 'Asume los objetivos de la función y coordina el trabajo de sus especialistas dentro del mandato acordado. La empresa conserva las decisiones estratégicas y los compromisos no autorizados.',
  };
  function updateMode() {
    const mode = document.querySelector<HTMLInputElement>('[name="autonomy"]:checked')?.value || 'scoped';
    text('autonomy-explanation', modes[mode]);
    updateContact();
  }
  function inspect(role: Role, button: HTMLButtonElement) {
    document.querySelectorAll<HTMLButtonElement>('.agent-node').forEach(node => node.setAttribute('aria-pressed', String(node === button)));
    text('role-title', role.name); text('role-mission', role.mission); list('role-work', role.work);
    text('role-rules', role.rules); text('role-sources', role.sources); text('role-decisions', role.decisions);
    text('explorer-status', `Puesto seleccionado: ${role.name}. Sus responsabilidades aparecen a continuación del esquema.`);
  }
  function updateContact() {
    if (!form) return;
    const values = new FormData(form);
    const size = document.querySelector<HTMLSelectElement>('#company-size')?.selectedOptions[0]?.textContent || '';
    const mode = document.querySelector<HTMLInputElement>('[name="autonomy"]:checked')?.parentElement?.textContent?.trim() || '';
    const body = `Hola, me gustaría revisar este esquema ilustrativo de Nutria.\n\nEmpresa: ${values.get('kind')}.\nTamaño: ${size}.\nNecesidad: ${currentScenario.label}.\nModo a explorar: ${mode}.\n\n${String(values.get('need') || '').trim()}\n\nQuisiera concretar los puestos, las integraciones y el alcance.`;
    const link = document.querySelector<HTMLAnchorElement>('#explorer-contact'); if (link) link.href = `mailto:info@ainutria.com?subject=${encodeURIComponent('Nutria · Mi organización')}&body=${encodeURIComponent(body)}`;
  }
  function buildResult() {
    if (!form) return;
    const values = new FormData(form);
    currentScenario = scenarios.find(s => s.id === values.get('scenario')) || scenarios[0];
    const size = String(values.get('size'));
    const small = size === 'small' || size === 'growing';
    const sizeText = document.querySelector<HTMLSelectElement>('#company-size')?.selectedOptions[0]?.textContent || '';
    text('company-summary', `${values.get('kind')} · ${sizeText} · ${currentScenario.label}`);
    text('human-team', small ? 'Dirección y equipo actual' : 'Dirección y responsables de área');
    text('area-label', currentScenario.area);
    text('size-guidance', small ? 'En un equipo compacto, un puesto puede concentrar varias funciones. Puedes empezar con un responsable y ampliar cuando el trabajo lo justifique.' : 'En una organización con varias áreas, conviene delimitar las relaciones con los responsables existentes, las marcas y los equipos con los que se comparte trabajo.');
    list('setup-checks', currentScenario.checks);
    const need = String(values.get('need') || '').trim();
    text('need-summary', need ? `Lo que quieres resolver: ${need}` : 'La estructura se ajustará al trabajo real; no es una dotación obligatoria por tamaño.');
    const operationNames: Record<string, string> = { 'Ecommerce y retail': 'Responsable de ecommerce', 'Servicios profesionales': 'Responsable de operaciones de servicio', 'Industria y distribución': 'Responsable de operaciones comerciales' };
    const leadName = currentScenario.id === 'operacion' ? operationNames[String(values.get('kind'))] || currentScenario.lead : currentScenario.lead;
    const lead: Role = { name: leadName, mission: currentScenario.mission, work: currentScenario.work, rules: currentScenario.rules, sources: currentScenario.sources, decisions: currentScenario.decisions };
    const roles: Role[] = [lead, ...(small ? currentScenario.specialists.slice(0, 1) : currentScenario.specialists)];
    const nodes = document.getElementById('agent-nodes'); nodes?.replaceChildren();
    const template = document.querySelector<HTMLTemplateElement>('#agent-node-template');
    roles.forEach((role, index) => {
      const button = template?.content.firstElementChild?.cloneNode(true) as HTMLButtonElement | undefined;
      if (!button) return;
      button.classList.toggle('coordinator-node', index === 0);
      button.querySelector('span')!.textContent = index === 0 ? 'RESPONSABILIDAD DEL ÁREA' : 'FUNCIÓN ESPECIALIZADA';
      button.querySelector('strong')!.textContent = role.name;
      button.addEventListener('click', () => inspect(role, button)); nodes?.append(button);
      if (index === 0) inspect(role, button);
    });
    updateMode(); step(3);
  }
  if (root && form) {
    root.querySelectorAll<HTMLElement>('[data-next]').forEach(button => button.addEventListener('click', () => step(Number(button.dataset.next))));
    root.querySelectorAll<HTMLElement>('[data-back]').forEach(button => button.addEventListener('click', () => step(Number(button.dataset.back))));
    form.addEventListener('submit', event => { event.preventDefault(); buildResult(); });
    document.querySelectorAll('[name="autonomy"]').forEach(input => input.addEventListener('change', updateMode));
    document.getElementById('explorer-reset')?.addEventListener('click', () => { form.reset(); const mode = document.querySelector<HTMLInputElement>('[name="autonomy"][value="scoped"]'); if (mode) mode.checked = true; step(1); });
    const inputs = document.querySelector<HTMLFieldSetElement>('#explorer-inputs');
    if (inputs) inputs.disabled = false;
  }
</script>
