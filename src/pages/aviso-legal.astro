---
import Layout from '../layouts/SiteLayout.astro';
---
<Layout title="Aviso legal" description="Aviso legal de Nutria." lang="es"><section class="legacy-content">
  <div>
    <div>
      <div>
        <h1>Aviso Legal</h1>

        <div>
          <div>
            <p>
              <strong>Última actualización:</strong> Fecha de revisión no indicada en el documento anterior
