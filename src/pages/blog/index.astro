---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/SiteLayout.astro';
import { formatEditorialDate } from '../../data/editorial';
const categoryOrder = ['Ingeniería', 'Ecosistema', 'Organización', 'Delegación', 'Integraciones'];
const articles = (await getCollection('articles')).sort((a, b) => categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category) || b.data.editedAt.getTime() - a.data.editedAt.getTime() || a.data.title.localeCompare(b.data.title, 'es'));
const datedArticles = articles.map(article => ({ article, date: article.data.status === 'published' && article.data.publishedAt ? article.data.publishedAt : article.data.editedAt }));
const categories = [...new Set(articles.map(article => article.data.category))].sort((a, b) => a.localeCompare(b, 'es'));
---
<Layout title="Blog" description="Ingeniería de agentes, decisiones de arquitectura y análisis del ecosistema, junto al trabajo de las organizaciones.">
<section><div class="page-intro"><p class="eyebrow">Blog de Nutria</p><h1>Cómo se construye<br />una nueva forma de trabajar.</h1><p class="lead">Ingeniería, problemas reales y decisiones de arquitectura. Qué resolvemos en Nutria, cómo se plantean esos retos en otros harnesses y qué caminos toma el ecosistema.</p></div>
<div class="editorial-toolbar"><div class="editorial-filters" role="group" aria-label="Filtrar artículos" hidden><button type="button" data-category-filter="Todos" aria-pressed="true">Todos</button>{categories.map(category => <button type="button" data-category-filter={category} aria-pressed="false">{category}</button>)}</div></div>
<p class="filter-status" role="status" aria-live="polite"></p>
<div class="editorial-list">{datedArticles.map(({ article, date }, i) => <article class="editorial-entry" data-category={article.data.category}><div class="editorial-entry-meta"><span class="row-number">0{i + 1}</span><p class="eyebrow">{article.data.category}</p></div><div><h2><a href={`/blog/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><div class="editorial-meta"><span>{article.data.status === 'published' ? 'Publicado' : 'Borrador editorial'}</span><time datetime={date.toISOString().slice(0, 10)}>{formatEditorialDate(date)}</time></div></div><a class="editorial-arrow" href={`/blog/${article.id}/`} aria-label={`Leer: ${article.data.title}`}>↗</a></article>)}</div>
</section>
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('.editorial-filters');
  if (filters) filters.hidden = false;
  document.querySelectorAll<HTMLButtonElement>('[data-category-filter]').forEach(button => button.addEventListener('click', () => {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-category]').forEach(entry => { entry.hidden = button.dataset.categoryFilter !== 'Todos' && entry.dataset.category !== button.dataset.categoryFilter; if (!entry.hidden) visible++; });
    document.querySelectorAll('[data-category-filter]').forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
    const status = document.querySelector<HTMLElement>('.filter-status');
    if (status) status.textContent = `${visible} ${visible === 1 ? 'artículo' : 'artículos'} en ${button.dataset.categoryFilter}.`;
  }));
</script>
