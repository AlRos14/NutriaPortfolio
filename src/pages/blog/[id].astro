---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/SiteLayout.astro';
import { formatEditorialDate } from '../../data/editorial';
export async function getStaticPaths() {
  return (await getCollection('articles')).map(article => ({ params: { id: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const outline = headings.filter(heading => heading.depth === 2);
const date = article.data.status === 'published' && article.data.publishedAt ? article.data.publishedAt : article.data.editedAt;
const related = (await getCollection('articles')).filter(entry => entry.id !== article.id && entry.data.category === article.data.category).sort((a, b) => a.id.localeCompare(b.id)).slice(0, 2);
---
<Layout title={article.data.title} description={article.data.description}>
<section class="editorial-hero"><a class="text-link editorial-back" href="/blog/">← Volver al blog</a><p class="eyebrow">{article.data.category}</p><h1>{article.data.title}</h1><p class="lead">{article.data.description}</p><div class="editorial-meta"><span>Nutria</span><span>{article.data.status === 'published' ? 'Publicado' : 'Borrador editorial'}</span><time datetime={date.toISOString().slice(0, 10)}>{formatEditorialDate(date)}</time></div></section>
<div class="editorial-reading"><aside class="editorial-outline"><p class="eyebrow">En este artículo</p><nav aria-label="Índice del artículo">{outline.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><a class="text-link" href="/agentes/">Conoce los agentes <span aria-hidden="true">↗</span></a></aside><article class="editorial-prose"><Content />{related.length > 0 && <div class="related-reading"><p class="eyebrow">Para seguir leyendo</p>{related.map(entry => <a href={`/blog/${entry.id}/`}>{entry.data.title} <span aria-hidden="true">→</span></a>)}</div>}</article></div>
<section class="closing"><div><p class="eyebrow">Del criterio al trabajo</p><h2>¿Qué responsabilidad<br /> quieres delegar?</h2></div><a class="button" href="/contacto/">Hablemos de tu equipo <span aria-hidden="true">↗</span></a></section>
</Layout>
