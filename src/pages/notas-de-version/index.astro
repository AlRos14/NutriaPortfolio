---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/SiteLayout.astro';
import { formatEditorialDate } from '../../data/editorial';
const releases = (await getCollection('releases')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const groups = [
  { historical: false, entries: releases.filter(release => release.data.status === 'verified') },
  { historical: true, entries: releases.filter(release => release.data.status === 'historical') },
].filter(group => group.entries.length > 0);
---
<Layout title="Notas de versión" description="Archivo de notas de versión de Nutria, separado de los artículos del blog.">
<section><div class="page-intro"><p class="eyebrow">Notas de versión</p><h1>El producto.<br /> Su historia.</h1><p class="lead">Un espacio para los cambios de Nutria, separado de los artículos sobre organización y trabajo delegado.</p></div>{groups.map(group => <div class="release-group">{group.historical ? <div class="historical-notice"><strong>Archivo histórico de 2025</strong><p>Estas notas conservan el contenido publicado entonces. No acreditan el estado actual de las capacidades ni anuncian nuevos lanzamientos.</p></div> : <h2 class="release-group-title">Cambios verificados</h2>}<div class="release-list">{group.entries.map(release => <article><div><span class="eyebrow">{group.historical ? 'Nota histórica' : 'Cambio verificado'}</span><time datetime={release.data.publishedAt.toISOString().slice(0, 10)}>{formatEditorialDate(release.data.publishedAt)}</time></div><h2><a href={`/notas-de-version/${release.id}/`}>{release.data.title}</a></h2><a class="editorial-arrow" href={`/notas-de-version/${release.id}/`} aria-label={`Leer ${group.historical ? 'nota histórica' : 'nota de versión'}: ${release.data.title}`}>↗</a></article>)}</div></div>)}<div class="section-end"><a class="text-link" href="/blog/">Leer el blog <span aria-hidden="true">→</span></a></div></section>
</Layout>
