import Layout from '../layouts/SiteLayout.astro';
---
<Layout title="NutriaBot identification" description="Identification and contact information for NutriaBot, Nutria's web content fetcher." lang="en">
<section class="legacy-content"><p class="eyebrow">Identification and contact</p><h1>NutriaBot/2.0</h1><p class="lead">NutriaBot is the web content fetcher used by Nutria. This page provides identification and a contact address for website operators.</p><h2>User-Agent</h2><p>Nutria's web fetcher identifies itself with this User-Agent:</p><pre><code>Mozilla/5.0 (compatible; NutriaBot/2.0; +https://ainutria.com)</code></pre><h2>Contact</h2><p>If you operate a website and have a question about a request from NutriaBot, contact <a href="mailto:info@ainutria.com">info@ainutria.com</a>. Include the public website URL and a description of the request. Do not include credentials or private user data.</p><h2>About Nutria</h2><p>Nutria is a platform for incorporating agents with defined roles, tools and authority into an organisation. Learn more on the <a href="/">Nutria website</a>.</p></section>
</Layout>
